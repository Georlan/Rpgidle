; RPG Idle — input/interface laboratory, not the production game build.
config_version=5

[application]
config/name="Rpgidle - Laboratorio de Controles"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=660
window/stretch/mode="canvas_items"
window/energy_saving/keep_screen_on=false

[input_devices]
joypads/ignore_joypad_on_unfocused_application=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
